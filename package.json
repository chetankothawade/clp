{
  "name": "loyalty-program-backend",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "npm --workspace apps/api-gateway run dev",
    "dev:auth": "npm --workspace apps/auth-service run dev",
    "dev:product": "npm --workspace apps/product-service run dev",
    "dev:loyalty": "npm --workspace apps/loyalty-service run dev",
    "dev:admin": "npm --workspace apps/admin-service run dev",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
